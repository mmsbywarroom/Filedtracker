{
  "name": "field-tracking-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Android & iOS app for Field Tracking (background GPS)",
  "scripts": {
    "build:plugin": "npm run build --prefix plugins/field-background-location",
    "cap:sync": "npm run build:plugin && npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:run:android": "npx cap run android",
    "cap:run:ios": "npx cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.1",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/preferences": "^7.0.1",
    "field-background-location": "file:plugins/field-background-location"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "typescript": "^5.6.2"
  },
  "capacitor": {
    "platforms": [
      "android",
      "ios"
    ]
  }
}
