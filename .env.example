DATABASE_URL="postgresql://fieldtrack:fieldtrack@localhost:5432/fieldtrack"
JWT_SECRET="replace-with-long-random-string"
ADMIN_EMAIL="admin@fieldtrack.local"
ADMIN_PASSWORD="change-me"

FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=
DLT_TEMPLATE_ID=

GOOGLE_MAPS_API_KEY=

# Required in production — used by /api/cron/auto-punch-out and deploy/auto-punch-out.sh
CRON_SECRET=

# GPS anti-spoof blocking is off by default. Set GPS_ANTI_SPOOF_ENABLED=true to re-enable legacy block rules.
# Attendance flag: every 30 min lat/lng between punch-in/out; admin flags if ≥8 same coords (no auto block).
# GPS_MIN_SAMPLES=3
# GPS_MAX_ACCURACY_M=80
# GPS_OBSERVE_MS=1800000
# GPS_NATURAL_MOVEMENT_M=20
# GPS_PINNED_SPREAD_M=2
# GPS_MIN_OBSERVATION_POINTS=8
# GPS_JITTER_CHECK_INTERVAL_MS=300000
# GPS_JITTER_MIN_POINTS=4
# GPS_RANDOM_PROBE_COUNT=6
# GPS_RANDOM_PROBE_WINDOW_MS=5400000
# GPS_RANDOM_PROBE_MIN_GAP_MS=240000
# GPS_REAL_PHONE_ACC_M=5
# GPS_REAL_ACC_RANGE_M=3
# GPS_SPOOF_PERFECT_ACC_M=3
# GPS_SPOOF_STABLE_ACC_RANGE_M=1.5
# GPS_MIN_CONVICTION_SAMPLES=8
