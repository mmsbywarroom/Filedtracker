generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String   @default("")
  passwordHash   String
  accessLevel    String   @default("State")
  isSuper        Boolean  @default(false)
  designations   String[] @default([])
  zone           String   @default("")
  district       String   @default("")
  assemblyName   String   @default("")
  /// Mapped assemblies for DLC / Cluster (multiple). ALC still uses assemblyName.
  assemblies     String[] @default([])
  cluster        String   @default("")
  createdAt      DateTime @default(now())
}

model User {
  id                  String   @id @default(cuid())
  name                String
  phone               String   @unique
  designation         String   @default("Sector Incharge")
  assemblyName        String
  sectorAllotted      String
  zone                String
  district            String
  cluster             String   @default("")
  faceDescriptorJson  String?
  faceImage           String?
  faceRegisteredAt    DateTime?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  punchInAt     DateTime
  punchOutAt    DateTime?
  punchInLat    Float
  punchInLng    Float
  punchOutLat   Float?
  punchOutLng   Float?
  punchInAddress String?
  punchOutAddress String?
  punchInFace     String?
  punchOutFace    String?
  punchOutReason  String?
  distanceMeters Float   @default(0)
  createdAt     DateTime @default(now())
  points        TrackPoint[]

  @@index([userId, punchInAt])
  @@index([punchOutReason])
}

model TrackPoint {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracy     Float?
  recordedAt   DateTime
  createdAt    DateTime   @default(now())

  @@index([attendanceId, recordedAt])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime
  toDate      DateTime
  reason      String
  status      String   @default("pending")
  adminNote   String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}
