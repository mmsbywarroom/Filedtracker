generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String   @default("")
  passwordHash   String
  accessLevel    String   @default("State")
  isSuper        Boolean  @default(false)
  designations   String[] @default([])
  zone           String   @default("")
  district       String   @default("")
  assemblyName   String   @default("")
  /// Mapped assemblies for DLC / Cluster (multiple). ALC still uses assemblyName.
  assemblies     String[] @default([])
  cluster        String   @default("")
  createdAt      DateTime @default(now())
}

model User {
  id                  String   @id @default(cuid())
  name                String
  phone               String   @unique
  designation         String   @default("Sector Incharge")
  assemblyName        String
  /// Multiple assemblies for ALC field users — punch allowed inside any mapped boundary
  assemblies          String[] @default([])
  sectorAllotted      String
  zone                String
  district            String
  cluster             String   @default("")
  faceDescriptorJson  String?
  faceImage           String?
  faceRegisteredAt    DateTime?
  /// Relaxed face match for turban/pagri — eyes, nose, mouth, beard; not forehead
  usesTurban          Boolean  @default(false)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  attendances         Attendance[]
  leaveRequests       LeaveRequest[]
  dailyAttendanceMarks DailyAttendanceMark[]
}

model DailyAttendanceMark {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar date in IST (stored as UTC midnight of YYYY-MM-DD)
  date        DateTime @db.Date
  status      String
  source      String   @default("manual")
  hoursWorked Float?
  note        String?
  markedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, date])
  @@index([date, status])
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([phone])
}

model Attendance {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  punchInAt     DateTime
  punchOutAt    DateTime?
  punchInLat    Float
  punchInLng    Float
  punchOutLat   Float?
  punchOutLng   Float?
  punchInAddress String?
  punchOutAddress String?
  punchInFace     String?
  punchOutFace    String?
  punchOutReason  String?
  punchInClient   String?
  punchOutClient  String?
  distanceMeters Float   @default(0)
  /// Max spread (m) of raw map GPS probes — real phones jitter 2–20 m; spoof apps stay pinned.
  gpsMapSpreadM  Float?
  /// Ms offsets from punch-in for 5–6 surprise GPS checks (client + server).
  gpsProbeSchedule Json?
  /// Raw map GPS fixes {lat,lng,accuracy,at} for spoof verdict audit (last ~80).
  gpsMapProbeLog Json?
  /// Latest GPS fix while session open (for admin live map — updated even when stationary).
  lastKnownLat   Float?
  lastKnownLng   Float?
  lastKnownAt    DateTime?
  createdAt     DateTime @default(now())
  points        TrackPoint[]
  gpsRandomProbes GpsRandomProbe[]
  intervalSnapshots AttendanceIntervalSnapshot[]

  @@index([userId, punchInAt])
  @@index([punchOutReason])
}

model TrackPoint {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  lat          Float
  lng          Float
  accuracy     Float?
  recordedAt   DateTime
  createdAt    DateTime   @default(now())

  @@index([attendanceId, recordedAt])
}

model GpsRandomProbe {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  slot         Int
  lat          Float
  lng          Float
  accuracy     Float?
  recordedAt   DateTime   @default(now())

  @@unique([attendanceId, slot])
  @@index([attendanceId])
}

/// Lat/lng every 30 min between punch-in and punch-out — used for admin flag (≥8 same coords).
model AttendanceIntervalSnapshot {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  slot         Int
  lat          Float
  lng          Float
  /// When this check was scheduled (punch-in + slot × 30 min).
  scheduledAt  DateTime?
  recordedAt   DateTime   @default(now())

  @@unique([attendanceId, slot])
  @@index([attendanceId])
}

model LeaveRequest {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromDate    DateTime
  toDate      DateTime
  reason      String
  status      String   @default("pending")
  adminNote   String?
  reviewedAt  DateTime?
  reviewedBy  String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Rally {
  id             String         @id @default(cuid())
  name           String
  lat            Float
  lng            Float
  scheduledDate  DateTime       @db.Date
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  users          RallyUser[]
  checkins       RallyCheckin[]

  @@index([scheduledDate])
  @@index([isActive])
}

model RallyUser {
  id          String         @id @default(cuid())
  rallyId     String
  rally       Rally          @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  zone        String
  district    String
  acName      String
  villageWard String         @default("")
  name        String
  phone       String         @unique
  vehicleNo   String         @default("")
  pocName     String         @default("")
  pocNumber   String         @default("")
  vehicleType String         @default("")
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  checkins    RallyCheckin[]

  @@index([rallyId])
  @@index([zone, district, acName])
}

model RallyCheckin {
  id             String    @id @default(cuid())
  rallyId        String
  rally          Rally     @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  userId         String
  user           RallyUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  photo          String
  headCount      Int       @default(0)
  lat            Float
  lng            Float
  distanceMeters Float     @default(0)
  etaSeconds     Int       @default(0)
  startedAt      DateTime  @default(now())
  reachedAt      DateTime?
  lastLat        Float?
  lastLng        Float?
  lastFixAt      DateTime?
  movedMeters    Float     @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([rallyId, startedAt])
  @@index([userId, startedAt])
}

/// Audit log when an admin clears a user's registered face
model FaceResetLog {
  id               String   @id @default(cuid())
  userId           String
  userName         String
  userPhone        String
  userDesignation  String   @default("")
  adminId          String
  adminName        String   @default("")
  adminEmail       String   @default("")
  adminAccessLevel String   @default("")
  reason           String
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([adminId])
}

/// Suspicious / blocked GPS activity (fake location apps, bad accuracy, etc.)
model GpsSpoofLog {
  id              String   @id @default(cuid())
  userId          String
  userName        String
  userPhone       String
  userDesignation String   @default("")
  assemblyName    String   @default("")
  zone            String   @default("")
  district        String   @default("")
  action          String
  outcome         String
  flags           String[] @default([])
  lat             Float?
  lng             Float?
  accuracy        Float?
  sampleCount     Int      @default(0)
  maxSpreadM      Float?
  detail          String
  attendanceId    String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([outcome])
}

/// Admin allowed punch despite GPS spoof block (until expiresAt, IST end-of-day by default).
model GpsSpoofBypass {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  adminId   String
  adminName String   @default("")
  reason    String
  logId     String?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Holiday {
  id            String   @id @default(cuid())
  date          DateTime @unique @db.Date
  reason        String
  /// Empty = nobody. Selected designations get Leave; only they cannot punch in.
  designations  String[] @default([])
  createdBy     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([date])
}
